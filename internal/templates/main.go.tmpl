package main

import (
	"fmt"
	"log"
	"net/http"
	"os"

	"{{ .ModuleName }}/internal/httpx"
	"github.com/joho/godotenv"
)

func main() {
	// * Load .env file
	err := godotenv.Load()
	if err != nil {
		log.Println("failed to load .env file. falling back to system environment variables.")
	}

	var port = os.Getenv("PORT")
	mux := http.NewServeMux()

	// * Health
	mux.HandleFunc("GET /api/health", func(w http.ResponseWriter, r *http.Request) {
		httpx.WriteJSON(w, http.StatusOK, "healthy", nil)
	})

	// * Start the server
	log.Println("server started on port", port)
	log.Fatal(http.ListenAndServe(fmt.Sprintf("127.0.0.1:%s", port), mux))
}
